DemoModel/m_ss_quantity_sum])", "name": "Units Sold"}], "value": {"columnId": "rKpiUnits01v"}}, {"id": "rKpiTrans01", "kind": "kpi-chart", "title": "Transactions", "source": {"connectionId": "66baa26c-c31a-4bf2-bd09-94801ec60ef6", "kind": "warehouse-table", "path": ["TPCDS-MM-Snowflake_main", "DemoModel"]}, "columns": [{"id": "rKpiTrans01v", "formula": "Sum([DemoModel/m_SS Row Counter_sum])", "name": "Transactions"}], "value": {"columnId": "rKpiTrans01v"}}, {"id": "rLineMonth1", "kind": "line-chart", "title": "Store Net Paid by Month", "source": {"connectionId": "66baa26c-c31a-4bf2-bd09-94801ec60ef6", "kind": "warehouse-table", "path": ["TPCDS-MM-Snowflake_main", "DemoModel"]}, "columns": [{"id": "rlx", "formula": "[DemoModel/Sold Calendar Month]", "name": "Month"}, {"id": "rly", "formula": "Sum([DemoModel/m_ss_net_paid_sum])", "name": "Net Paid"}], "xAxis": {"columnId": "rlx"}, "yAxis": {"columnIds": ["rly"]}}, {"id": "rBarState01", "kind": "bar-chart", "title": "Net Paid by Store State", "source": {"connectionId": "66baa26c-c31a-4bf2-bd09-94801ec60ef6", "kind": "warehouse-table", "path": ["TPCDS-MM-Snowflake_main", "DemoModel"]}, "columns": [{"id": "rsx", "formula": "[DemoModel/d_store_state]", "name": "Store State"}, {"id": "rsy", "formula": "Sum([DemoModel/m_ss_net_paid_sum])", "name": "Net Paid"}], "xAxis": {"columnId": "rsx"}, "yAxis": {"columnIds": ["rsy"]}}, {"id": "rBarCateg01", "kind": "bar-chart", "title": "Net Profit by Product Category", "source": {"connectionId": "66baa26c-c31a-4bf2-bd09-94801ec60ef6", "kind": "warehouse-table", "path": ["TPCDS-MM-Snowflake_main", "DemoModel"]}, "columns": [{"id": "rcx", "formula": "[DemoModel/I Category]", "name": "Category"}, {"id": "rcy", "formula": "Sum([DemoModel/m_ss_net_profit_sum])", "name": "Net Profit"}], "xAxis": {"columnId": "rcx"}, "yAxis": {"columnIds": ["rcy"]}}, {"id": "rTblBrands1", "kind": "table", "title": "Brands by Net Paid (highest first)", "source": {"connectionId": "66baa26c-c31a-4bf2-bd09-94801